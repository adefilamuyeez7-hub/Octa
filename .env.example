# Frontend
VITE_API_URL=http://localhost:3001

# Backend
PORT=3001
NODE_ENV=development

# AI API Keys (Claude recommended as default)
# - Claude: https://docs.anthropic.com (primary - claude-sonnet-4-20250514)
# - Grok/xAI: https://x.ai (fallback)
# - Gemini: https://ai.google.dev (fallback)

ANTHROPIC_API_KEY=your_claude_api_key_here

# Optional: xAI Grok API (fallback)
GROK_API_KEY=xai-your_api_key_here

# Optional: Google Gemini API (fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Notion API (Optional - for future Notion integration)
NOTION_API_KEY=your_notion_api_key_here
NOTION_DB_ID=your_notion_database_id_here

