# Frontend
VITE_API_URL=http://localhost:3001

# Backend
PORT=3001
NODE_ENV=development

# ===== SECURITY: API Keys are set via Vercel Environment Variables =====
# DO NOT commit real API keys to this repository
# Set these in your Vercel project dashboard: Settings > Environment Variables
# https://vercel.com/docs/projects/environment-variables

# AI API Keys (server-side only - never exposed to client)
ANTHROPIC_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
XAI_API_KEY=your_xai_api_key_here
XAI_API_URL=https://api.x.ai/v1/responses
XAI_MODEL=grok-latest
GROK_API_KEY=your_grok_api_key_here

# Moltbot Webhook (Optional)
MOLTBOT_WEBHOOK_URL=
MOLTBOT_API_KEY=
MOLTBOT_AGENT_ID=main

# Notion API (Optional - for Notion integration)
NOTION_API_KEY=your_notion_api_key_here
NOTION_DB_ID=your_notion_database_id_here

